rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(profileId) {
      return /databases/$(database)/documents/profiles/$(profileId);
    }

    function memberPath(profileId, userId) {
      return /databases/$(database)/documents/profiles/$(profileId)/members/$(userId);
    }

    function profileOwner(profileId) {
      return signedIn()
        && exists(profilePath(profileId))
        && get(profilePath(profileId)).data.userId == request.auth.uid;
    }

    function profileMember(profileId) {
      return signedIn()
        && exists(memberPath(profileId, request.auth.uid));
    }

    function canAccessProfile(profileId) {
      return profileOwner(profileId) || profileMember(profileId);
    }

    function canEditProfile(profileId) {
      return profileOwner(profileId)
        || (
          profileMember(profileId)
          && get(memberPath(profileId, request.auth.uid)).data.role in ['owner', 'editor']
        );
    }

    function sourceTransactionReleased(profileId, transactionId) {
      let lockPath = /databases/$(database)/documents/splitSourceLocks/$(profileId)/transactions/$(transactionId);
      return !exists(lockPath) || get(lockPath).data.status == 'released';
    }

    // Investment transfers are the only supported bridge between the portfolio
    // ledger and the daily finance ledger. Both matching rows, the bank balance,
    // and the holding value must move in the same atomic write.
    function validMainInvestmentTransfer(profileId, transactionId) {
      let direction = request.resource.data.get('investmentTransferDirection', '');
      let investmentId = request.resource.data.get('investmentId', '__missing__');
      let ledgerEntryId = request.resource.data.get('investmentLedgerEntryId', '__missing__');
      let accountId = request.resource.data.get('accountId', '__missing__');
      let investmentPath = /databases/$(database)/documents/profiles/$(profileId)/investments/$(investmentId);
      let ledgerPath = /databases/$(database)/documents/profiles/$(profileId)/investments/$(investmentId)/transactions/$(ledgerEntryId);
      let accountPath = /databases/$(database)/documents/profiles/$(profileId)/accounts/$(accountId);

      return request.resource.data.get('kind', '') == 'investment-transfer'
        && request.resource.data.get('investmentTransferId', '') == transactionId
        && direction in ['in', 'out']
        && investmentId is string
        && ledgerEntryId is string
        && accountId is string
        && request.resource.data.get('amount', 0) is number
        && request.resource.data.get('amount', 0) > 0
        && request.resource.data.get('amountInPaise', 0) is int
        && request.resource.data.get('amountInPaise', 0) > 0
        && exists(investmentPath)
        && exists(accountPath)
        && get(accountPath).data.type == 'bank'
        && existsAfter(ledgerPath)
        && getAfter(ledgerPath).data.type == 'bank_transfer'
        && getAfter(ledgerPath).data.direction == direction
        && getAfter(ledgerPath).data.transferId == transactionId
        && getAfter(ledgerPath).data.mainTransactionId == transactionId
        && getAfter(ledgerPath).data.investmentId == investmentId
        && getAfter(ledgerPath).data.accountId == accountId
        && getAfter(ledgerPath).data.amountInPaise ==
          (direction == 'in'
            ? request.resource.data.amountInPaise
            : -request.resource.data.amountInPaise)
        && (
          (direction == 'in'
            && request.resource.data.type == 'expense'
            && request.resource.data.category == 'Investment Transfer'
            && getAfter(accountPath).data.balance < get(accountPath).data.balance
            && getAfter(investmentPath).data.currentValue > get(investmentPath).data.currentValue)
          ||
          (direction == 'out'
            && request.resource.data.type == 'income'
            && request.resource.data.category == 'Investment Withdrawal'
            && getAfter(accountPath).data.balance > get(accountPath).data.balance
            && getAfter(investmentPath).data.currentValue < get(investmentPath).data.currentValue)
        );
    }

    function validInvestmentLedgerTransfer(profileId, investmentId, ledgerTransactionId) {
      let mainTransactionPath = /databases/$(database)/documents/profiles/$(profileId)/transactions/$(request.resource.data.mainTransactionId);
      let accountPath = /databases/$(database)/documents/profiles/$(profileId)/accounts/$(request.resource.data.accountId);
      let investmentPath = /databases/$(database)/documents/profiles/$(profileId)/investments/$(investmentId);
      let direction = request.resource.data.direction;
      return request.resource.data.investmentId == investmentId
        && request.resource.data.accountId is string
        && request.resource.data.mainTransactionId is string
        && request.resource.data.transferId is string
        && request.resource.data.transferId == request.resource.data.mainTransactionId
        && direction in ['in', 'out']
        && request.resource.data.amountInPaise is int
        && existsAfter(mainTransactionPath)
        && exists(investmentPath)
        && exists(accountPath)
        && getAfter(accountPath).data.type == 'bank'
        && getAfter(mainTransactionPath).data.kind == 'investment-transfer'
        && getAfter(mainTransactionPath).data.investmentTransferDirection == direction
        && getAfter(mainTransactionPath).data.investmentTransferId == request.resource.data.transferId
        && getAfter(mainTransactionPath).data.investmentId == investmentId
        && getAfter(mainTransactionPath).data.investmentLedgerEntryId == ledgerTransactionId
        && getAfter(mainTransactionPath).data.accountId == request.resource.data.accountId
        && (
          (direction == 'in'
            && request.resource.data.amountInPaise > 0
            && getAfter(mainTransactionPath).data.type == 'expense'
            && getAfter(mainTransactionPath).data.category == 'Investment Transfer'
            && getAfter(mainTransactionPath).data.amountInPaise == request.resource.data.amountInPaise
            && getAfter(accountPath).data.balance < get(accountPath).data.balance
            && getAfter(investmentPath).data.currentValue > get(investmentPath).data.currentValue)
          ||
          (direction == 'out'
            && request.resource.data.amountInPaise < 0
            && getAfter(mainTransactionPath).data.type == 'income'
            && getAfter(mainTransactionPath).data.category == 'Investment Withdrawal'
            && getAfter(mainTransactionPath).data.amountInPaise == -request.resource.data.amountInPaise
            && getAfter(accountPath).data.balance > get(accountPath).data.balance
            && getAfter(investmentPath).data.currentValue < get(investmentPath).data.currentValue)
        );
    }

    function acceptedFriendRequestExists(userId, friendId) {
      let forwardPath = /databases/$(database)/documents/friendRequests/$(userId + '_' + friendId);
      let reversePath = /databases/$(database)/documents/friendRequests/$(friendId + '_' + userId);

      return (
        existsAfter(forwardPath)
        && getAfter(forwardPath).data.status == 'accepted'
      ) || (
        existsAfter(reversePath)
        && getAfter(reversePath).data.status == 'accepted'
      );
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId;
    }

    match /profiles/{profileId} {
      // Required by the app's current friend-search query.
      // All signed-in users can read profile metadata.
      allow read: if signedIn();

      allow create:
        if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update:
        if profileOwner(profileId)
        && request.resource.data.userId == resource.data.userId;

      allow delete: if profileOwner(profileId);

      match /members/{memberId} {
        allow read: if canAccessProfile(profileId);

        allow create:
          if profileOwner(profileId)
          && request.resource.data.role in ['owner', 'editor', 'viewer'];

        allow update:
          if profileOwner(profileId)
          && request.resource.data.role in ['owner', 'editor', 'viewer'];

        allow delete: if profileOwner(profileId);
      }

      match /accounts/{accountId} {
        allow read: if canAccessProfile(profileId);
        allow create:
          if canEditProfile(profileId)
          && (
            !request.resource.data.keys().hasAny(['balance'])
            || (request.resource.data.balance is number && request.resource.data.balance >= 0)
          );
        allow update:
          if canEditProfile(profileId)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance'])
            || (request.resource.data.balance is number && request.resource.data.balance >= 0)
          );
        allow delete: if canEditProfile(profileId);
      }

      match /transactions/{transactionId} {
        allow read: if canAccessProfile(profileId);
        allow create:
          if canEditProfile(profileId)
          && (
            // Investment-to-bank and bank-to-investment transfers have their own
            // paired-write validation and are not ordinary income/expense rows.
            (request.resource.data.kind == 'investment-transfer'
              && validMainInvestmentTransfer(profileId, transactionId))

            // Ordinary transactions must not contain reserved split/server fields.
            || (
              !request.resource.data.keys().hasAny([
                'kind', 'splitId', 'settlementId', 'serverGenerated'
              ])
              && !request.resource.data.keys().hasAny([
                'investmentTransferId', 'investmentTransferDirection', 'investmentLedgerEntryId', 'investmentId', 'investmentName', 'assetClass'
              ])
            )

            // Permit only a specifically shaped self-transfer.
            || (
              request.resource.data.kind == 'self-transfer'
              && request.resource.data.type in ['income', 'expense']
              && request.resource.data.transferDirection in ['in', 'out']
              && request.resource.data.transferId is string
              && request.resource.data.amount is number
              && request.resource.data.amount > 0
              && request.resource.data.accountId is string
              && !request.resource.data.keys().hasAny([
                'investmentTransferId', 'investmentTransferDirection', 'investmentLedgerEntryId', 'investmentId', 'investmentName', 'assetClass'
              ])
              && exists(
                /databases/$(database)/documents/profiles/$(profileId)/accounts/$(request.resource.data.accountId)
              )
            )
          );

        allow update:
          if canEditProfile(profileId)
          && !resource.data.keys().hasAny(['kind', 'serverGenerated'])
          && !request.resource.data.keys().hasAny(['kind', 'splitId', 'settlementId', 'serverGenerated'])
          && !request.resource.data.keys().hasAny(['investmentTransferId', 'investmentTransferDirection', 'investmentLedgerEntryId', 'investmentId', 'investmentName', 'assetClass'])
          && !resource.data.keys().hasAny(['investmentTransferId', 'investmentTransferDirection', 'investmentLedgerEntryId', 'investmentId', 'investmentName', 'assetClass'])
          && sourceTransactionReleased(profileId, transactionId);

        allow delete:
          if canEditProfile(profileId)
          && !resource.data.keys().hasAny(['kind', 'serverGenerated'])
          && !resource.data.keys().hasAny(['investmentTransferId', 'investmentTransferDirection', 'investmentLedgerEntryId', 'investmentId', 'investmentName', 'assetClass'])
          && sourceTransactionReleased(profileId, transactionId);
      }

      match /budgets/{budgetId} {
        allow read: if canAccessProfile(profileId);
        allow create, update, delete: if canEditProfile(profileId);
      }

      match /goals/{goalId} {
        allow read: if canAccessProfile(profileId);
        allow create, update, delete: if canEditProfile(profileId);
      }

      match /investments/{investmentId} {
        allow read: if canAccessProfile(profileId);
        allow create, update, delete: if canEditProfile(profileId);

        match /transactions/{transactionId} {
          allow read: if canAccessProfile(profileId);
          allow create:
            if canEditProfile(profileId)
            && (
              request.resource.data.type != 'bank_transfer'
              || validInvestmentLedgerTransfer(profileId, investmentId, transactionId)
            );
          allow update:
            if canEditProfile(profileId)
            && resource.data.type != 'bank_transfer'
            && request.resource.data.type != 'bank_transfer';
          allow delete:
            if canEditProfile(profileId) && resource.data.type != 'bank_transfer';
        }
      }

      match /netWorthSnapshots/{snapshotId} {
        allow read: if canAccessProfile(profileId);
        allow create, update, delete: if canEditProfile(profileId);
      }

      // Portfolio-level value history. Each snapshot is written atomically with
      // the corresponding investment ledger event (including bank transfers).
      match /investmentSnapshots/{snapshotId} {
        allow read: if canAccessProfile(profileId);
        allow create, update, delete: if canEditProfile(profileId);
      }
    }

    match /categories/{categoryId} {
      allow read: if signedIn();

      // Seed/manage categories using an admin-claimed account or Admin SDK.
      allow create, update, delete:
        if signedIn() && request.auth.token.admin == true;
    }

    match /friendRequests/{requestId} {
      allow read:
        if signedIn()
        && (
          resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid
        );

      allow create:
        if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUserId
        && request.resource.data.status == 'pending';

      allow update:
        if signedIn()
        && resource.data.toUserId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);

      // The current app rejects requests by deleting them as the recipient.
      allow delete:
        if signedIn() && resource.data.toUserId == request.auth.uid;
    }

    match /friends/{friendshipId} {
      allow read:
        if signedIn() && resource.data.userId == request.auth.uid;

      allow create:
        if signedIn()
        && friendshipId ==
          request.resource.data.userId + '_' + request.resource.data.friendId
        && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.friendId == request.auth.uid
        )
        && acceptedFriendRequestExists(
          request.resource.data.userId,
          request.resource.data.friendId
        );

      allow delete:
        if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.friendId == request.auth.uid
        );

      allow update: if false;
    }

    match /splits/{splitId} {
      allow read:
        if signedIn()
        && (request.auth.uid == resource.data.createdBy
          || request.auth.uid == resource.data.paidByUserId
          || request.auth.uid in resource.data.participantIds);

      // Split creation, state transitions, and cancellation are trusted-function only.
      allow create, update, delete: if false;

      match /settlements/{settlementId} {
        allow read: if signedIn()
          && (
            request.auth.uid == get(/databases/$(database)/documents/splits/$(splitId)).data.createdBy
            || request.auth.uid == get(/databases/$(database)/documents/splits/$(splitId)).data.paidByUserId
            || request.auth.uid in get(/databases/$(database)/documents/splits/$(splitId)).data.participantIds
          );
        allow create, update, delete: if false;
      }
    }

    match /friendSettlements/{settlementId} {
      // Client reads only requests in which the signed-in user is a direct party.
      // Clique-wide effects are calculated by the trusted Edge Function, so
      // other members do not need direct access to counterparties' payment rows.
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;
    }

    match /splitSourceLocks/{profileId}/transactions/{transactionId} {
      allow read, create, update, delete: if false;
    }
  }
}