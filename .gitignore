# iOS Native Configs & Build Outputs
# -------------------------------------------------------------------
ios/DerivedData/
ios/build/
ios/Pods/
ios/Podfile.lock
.xcode.env.local

# Xcode user-specific settings
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
*.xcworkspace
!ios/*.xcworkspace/contents.xcworkspacedata # Keep the workspace structure, ignore the user data

